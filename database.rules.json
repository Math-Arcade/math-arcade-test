{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val().length < 40"
      },
      ".read": true
    },
    "leaderboard": {
      "$mode": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'score']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100000 && (!data.exists() || newData.child('score').val() >= data.child('score').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber()"
          },
          "pic": {
            ".validate": "newData.isString() && newData.val().length <= 8000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
          },
          "lvl": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "frame": {
            ".validate": "newData.isString() && newData.val().matches(/^(neon|ember|frost|pixel|royal|gold|aurora|rainbow)$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "publicProfiles": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'theme', 'stats'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "theme": {
          ".validate": "newData.isString() && newData.val().matches(/^(green|blue|red|yellow|purple|light|dark|colorblind)$/)"
        },
        "pic": {
          ".validate": "newData.isString() && newData.val().length <= 14000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
        },
        "stats": {
          ".validate": "newData.hasChildren(['best'])",
          "blitzGames": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "correct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "wrong": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "bestStreak": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "bestLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "seconds": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "dailies": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "dailyStreak": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "best": {
            "mix": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "add": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "sub": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "mul": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "div": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "updated": {
          ".validate": "newData.isNumber()"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "titleLevel": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        },
        "frame": {
          ".validate": "newData.isString() && newData.val().matches(/^(neon|ember|frost|pixel|royal|gold|aurora|rainbow)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($friend).exists())) || (auth.uid === $friend && (!newData.exists() || root.child('friendRequests').child($friend).child($uid).exists())))",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to ? !newData.exists() : (auth.uid === $from && $from !== $to))",
          ".validate": "newData.hasChildren(['name', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friendSent": {
      "$from": {
        ".read": "auth != null && auth.uid === $from",
        "$to": {
          ".write": "auth != null && (auth.uid === $from ? $from !== $to : (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "dailyResults": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        "$day": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['name', 'score', 'total'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
          },
          "grid": {
            ".validate": "newData.isString() && newData.val().matches(/^[01]{1,50}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
