{
  "name": "math-arcade",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Math Arcade - fast, fun mental-math arcade game (PWA, Capacitor-ready)",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "python3 tests/e2e/e2e.py",
    "test:rules": "node --test tests/rules/rules.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --only database --project math-arcade-rules \"node tests/rules/emulator.test.mjs\"",
    "test:accounts": "python3 tests/e2e/accounts.py"
  },
  "devDependencies": {
    "targaryen": "^3.1.0",
    "@firebase/rules-unit-testing": "^3.0.0",
    "firebase": "^10.13.1",
    "firebase-tools": "^13.0.0"
  }
}
